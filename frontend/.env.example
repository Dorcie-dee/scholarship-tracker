# ==============================================================================
# Scholarship OS frontend — environment configuration
#
# Next.js only reads `.env.local` (and only exposes `NEXT_PUBLIC_*` vars to the
# browser) — copy this file there:
#   cp .env.example .env.local
#
# The value below works as-is against the backend's own sample.env (same port).
# NEVER commit the real `.env.local` (see .gitignore) — this file is the only
# env file meant to be committed.
# ==============================================================================

# Base URL of the backend API, including the /api prefix. Must match the
# backend's API_PORT (see ../backend/sample.env) and be reachable from the
# browser (not just from wherever Next.js itself runs).
NEXT_PUBLIC_API_URL=http://localhost:8769/api
