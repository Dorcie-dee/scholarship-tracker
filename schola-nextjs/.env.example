# ==============================================================================
# Schola (Next.js + MongoDB) — environment configuration
#
# Copy this to `.env.local`:
#   cp .env.example .env.local
#
# NEVER commit the real `.env.local` (see .gitignore) — this file is the only
# env file meant to be committed.
# ==============================================================================

NODE_ENV=development
# This app's own base URL — frontend and backend are the same Next.js app
# here, so this is used only to build links in emails (verify-email/reset-password).
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database — MongoDB Atlas (or any replica-set-backed MongoDB; this app uses
# real multi-document transactions for safety-critical writes, which plain
# standalone MongoDB does not support). Leave unset in tests — the test suite
# spins up an ephemeral in-memory replica set via mongodb-memory-server instead.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/schola?retryWrites=true&w=majority
MONGODB_DB_NAME=schola

# ------------------------------------------------------------------------------
# Authentication / JWT (jose). Signs every access token — anyone who has
# this value can mint a token for any user/role. There is no default: the
# app refuses to start in production without it, and generates a random
# (process-lifetime-only) one in development if left unset here. Generate a
# real value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
BCRYPT_SALT_ROUNDS=10

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

PASSWORD_RESET_EXPIRY_MINUTES=30

AUTH_ARTIFACT_RETENTION_DAYS=7

# Account-scoped login brute-force throttle — a self-recovering window, not a
# permanent lock. Backed by a MongoDB TTL collection (see server/lib/rate-limit.ts).
LOGIN_LOCKOUT_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# ------------------------------------------------------------------------------
# Email delivery (OTP verification / password reset) — SMTP. Leave
# EMAIL_SMTP_HOST blank in development: emails are logged instead of sent.
# ------------------------------------------------------------------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@schola.local
EMAIL_FROM_NAME=Schola

# ------------------------------------------------------------------------------
# Cloudinary (document storage) — leave blank to skip; upload fails with a
# clear error until these are set.
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DOCUMENT_MAX_UPLOAD_BYTES=20971520
DOCUMENT_ALLOWED_MIME_TYPES=
DOCUMENT_SIGNED_URL_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Pagination
# ------------------------------------------------------------------------------
PAGINATION_DEFAULT_PAGE_SIZE=25
PAGINATION_MAX_PAGE_SIZE=100

APPLICATION_SOFT_DELETE_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# URL fetch (OpportunitySource preview / autoFetch) — SSRF-hardened
# ------------------------------------------------------------------------------
URL_FETCH_TIMEOUT_MS=8000
URL_FETCH_MAX_RESPONSE_BYTES=1048576
URL_FETCH_MAX_REDIRECTS=3

# ------------------------------------------------------------------------------
# Requirement AI suggestions (heuristic provider by default)
# ------------------------------------------------------------------------------
REQUIREMENT_AI_ENABLED=true
REQUIREMENT_AI_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Seed data (development only — see server/scripts/seed.ts). Never a real
# address/password.
# ------------------------------------------------------------------------------
SEED_USER_EMAIL=demo@schola.local
SEED_USER_PASSWORD=dev_only_demo_password_1234

# ------------------------------------------------------------------------------
# Scheduled maintenance (/api/cron/*) — purging soft-deleted Applications past
# their retention window, and expired auth artifacts (refresh sessions, OTPs,
# password reset tokens). No in-process cron host in Next.js, so an external
# scheduler (e.g. the GitHub Actions workflow in .github/workflows/) calls
# these on a timer with this secret as a Bearer token. No default — unset
# means the endpoints always reject, not "open." Generate one the same way as
# JWT_ACCESS_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------------------
CRON_SECRET=
