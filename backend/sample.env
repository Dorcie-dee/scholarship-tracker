# ==============================================================================
# Scholarship OS backend — environment configuration
#
# Copy this to `.env` in this directory:
#   cp sample.env .env
#
# The values below work as-is against a freshly-created local Postgres (see
# docs/development.md for the exact `CREATE ROLE`/`CREATE DATABASE` commands) —
# no editing required to get running. Before doing anything beyond a quick
# local try, replace JWT_ACCESS_SECRET with a real random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# NEVER commit the real `.env` (see .gitignore) — this file (sample.env) is the
# only env file meant to be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
NODE_ENV=development
# Port this API listens on.
API_PORT=8769
# Base URL of the frontend — used for CORS (must match exactly, incl. scheme/port).
FRONTEND_URL=http://localhost:3000
# Production hardening — how many reverse-proxy hops in front of this process
# are trusted when resolving the real client IP from X-Forwarded-For. 0 (the
# default) is safe for local dev and for "no reverse proxy at all". Set to 1
# for a real deployment sitting behind exactly one load balancer/reverse
# proxy (the common case) — see src/config/configuration.ts's doc comment on
# `trustProxyHops` for why a larger number is NOT "safer".
TRUST_PROXY_HOPS=0

# ------------------------------------------------------------------------------
# Database (PostgreSQL via TypeORM)
#
# Works against local Postgres, Docker, or a managed provider (Neon, RDS,
# Heroku, ...) — just fill in that provider's host/port/db/user/password and
# set POSTGRES_SSL=true (managed providers almost always require SSL; local
# Postgres almost never does).
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scholarship_os_dev
POSTGRES_USER=scholarship_os
POSTGRES_PASSWORD=scholarship_os_dev_password
POSTGRES_SSL=false
# Full connection string is derived from the above by src/config/configuration.ts,
# but can be supplied directly instead if preferred (takes precedence when set).
# DATABASE_URL=postgres://scholarship_os:scholarship_os_dev_password@localhost:5432/scholarship_os_dev

# Connection pool — see docs/decisions.md, "Connection pool sizing". Size so
# that (number of API instances) x DB_POOL_MAX stays under your Postgres
# provider's connection ceiling.
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_CONNECT_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000
# Server-side backstop against a runaway query holding a connection
# indefinitely — see src/database/statement-timeout.provider.ts.
DB_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# Authentication / JWT
# ------------------------------------------------------------------------------
# Secret used to sign short-lived access tokens. The value below is an
# obviously-fake dev placeholder — generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_please_1234567890
# Access token lifetime (jsonwebtoken "expiresIn" format).
JWT_ACCESS_EXPIRES_IN=15m
# Refresh session lifetime in days — how long an issued refresh cookie stays valid
# if never used, and the upper bound on a session's life even with rotation.
REFRESH_TOKEN_TTL_DAYS=30
# Name of the HttpOnly cookie carrying the refresh credential.
REFRESH_COOKIE_NAME=refresh_token
# bcrypt cost factor for password hashing (bcryptjs — see docs/decisions.md).
# Lower than the production-appropriate value (12+) so local hashing is fast.
BCRYPT_SALT_ROUNDS=10

# Email-verification OTP: how long a code stays valid, how many wrong guesses
# are allowed before it's invalidated, and the minimum gap between resends.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Password-reset token lifetime.
PASSWORD_RESET_EXPIRY_MINUTES=30

# How long past expiry/consumption/invalidation a refresh session, OTP, or
# password-reset token is kept before the hourly cleanup job purges it — see
# src/auth/auth-cleanup.service.ts.
AUTH_ARTIFACT_RETENTION_DAYS=7

# Account-scoped login brute-force throttle (additive to IP-based rate
# limiting) — see src/auth/login-guard.service.ts. A THROTTLE, not a
# permanent lock: after this many failures within the window, further
# attempts for that account are rejected for the rest of the window only.
LOGIN_LOCKOUT_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_SECONDS=900

# ------------------------------------------------------------------------------
# Redis — OPTIONAL. Leave blank for a single-instance deployment (including
# local development): rate limiting and login-lockout both fall back to
# safe, correct, documented in-memory/per-process behavior automatically.
# Only required once this API runs as more than one instance behind a load
# balancer — see docs/decisions.md, "Distributed rate limiting".
# ------------------------------------------------------------------------------
REDIS_URL=

# ------------------------------------------------------------------------------
# Email delivery (OTP verification / password reset) — SMTP, not a
# vendor-specific SDK, so any real provider works (SES, SendGrid, Postmark,
# Mailgun, a corporate relay, ...) — see common/email/email.service.ts and
# docs/decisions.md, "Email delivery: SMTP, not a vendor SDK".
#
# Leave EMAIL_SMTP_HOST blank in development: emails are logged instead of
# sent (clearly marked, never a real delivery) so you can read an OTP/reset
# link locally. In production, EMAIL_SMTP_HOST is REQUIRED — the app refuses
# to start without it rather than silently failing to deliver later.
# ------------------------------------------------------------------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
# true only for port 465 (implicit TLS) — 587/25 negotiate TLS via STARTTLS.
EMAIL_SMTP_SECURE=false
# Must be set together, or both left blank for an unauthenticated relay.
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@scholarship-os.local
EMAIL_FROM_NAME=Scholarship OS

# ------------------------------------------------------------------------------
# Cloudinary (document storage) — leave blank to skip: document upload just
# fails with a clear error until these are set (see common/cloudinary/cloudinary.service.ts)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Maximum upload size for a single document (bytes).
DOCUMENT_MAX_UPLOAD_BYTES=20971520
# Comma-separated MIME allowlist. Leave blank to use the built-in default
# (PDF, common image formats, Word) — see src/config/configuration.ts.
DOCUMENT_ALLOWED_MIME_TYPES=
# The validity window communicated to the client as `expiresInSeconds` for a
# signed, authenticated Cloudinary delivery URL. NOT yet server-enforced by
# Cloudinary itself (that requires a separate account add-on this app has no
# way to detect/configure) — the URL is genuinely signed/unguessable, but
# does not actually stop working after this many seconds. See
# docs/decisions.md, "Honest scope on 'signed' vs. 'time-expiring'".
DOCUMENT_SIGNED_URL_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Pagination — default/maximum page size for every collection endpoint.
# ------------------------------------------------------------------------------
PAGINATION_DEFAULT_PAGE_SIZE=25
PAGINATION_MAX_PAGE_SIZE=100

# How long a soft-deleted Application is kept before the hard-purge job
# permanently removes it and its history.
APPLICATION_SOFT_DELETE_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# URL fetch (OpportunitySource preview / autoFetch) — SSRF-hardened
# ------------------------------------------------------------------------------
URL_FETCH_TIMEOUT_MS=8000
URL_FETCH_MAX_RESPONSE_BYTES=1048576
URL_FETCH_MAX_REDIRECTS=3

# ------------------------------------------------------------------------------
# Requirement AI suggestions (heuristic provider by default)
# ------------------------------------------------------------------------------
REQUIREMENT_AI_ENABLED=true
REQUIREMENT_AI_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Seed data (development only — see src/database/seed.ts)
# ------------------------------------------------------------------------------
# Login email for the seeded demo account. Intentionally NOT a real address.
SEED_USER_EMAIL=demo@scholarship-os.local
# Password for the seeded demo account. Required to run `yarn seed` — there is
# no hardcoded fallback so a real password never ends up in source control.
SEED_USER_PASSWORD=dev_only_demo_password_1234
